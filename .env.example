# Copy to .env and fill in. .env is git-ignored; this file is not.

# Your PS5's LAN IP (PS5: Settings > Network > Connection Status).
# Required. --ps5-ip on the command line overrides it.
GT7_PS5_IP=

# Voice coach (web dashboard only). Leave blank to turn a piece off:
#   no LLM URL  -> the coach speaks fixed fallback lines
#   no TTS URL  -> callouts show as captions, no audio

# OpenAI-compatible chat endpoint, including /v1
GT7_LLM_URL=
# Model id; blank = first model the endpoint lists
GT7_LLM_MODEL=

# OpenAI-compatible TTS endpoint (e.g. cleanTTS), including /v1
GT7_TTS_URL=
# Voice id; blank = bm_george
GT7_TTS_VOICE=
